# Copier ce fichier en .env et remplir avec vos identifiants francetravail.io
# (Mes applications -> Créer une application -> API « Offres d'emploi v2 »)
FT_CLIENT_ID=PAR_votre_application_xxxxxxxx
FT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Sources supplémentaires pour la veille alternance (scripts/alternance.mjs), toutes facultatives ----
# La bonne alternance (API officielle de l'alternance) : compte gratuit sur https://api.apprentissage.beta.gouv.fr
# (Se connecter / S'inscrire -> Mon compte -> générer une clé d'API)
LBA_API_KEY=votre_cle_lba
# Adzuna (agrégateur d'offres, API ouverte) : compte gratuit sur https://developer.adzuna.com
ADZUNA_APP_ID=votre_app_id
ADZUNA_APP_KEY=votre_app_key
